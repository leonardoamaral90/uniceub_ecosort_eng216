# ==========================================================
# EcoSort local environment
# ==========================================================

# Kaggle dataset oficial informado para o projeto
KAGGLE_DATASET=sumn2u/garbage-classification-v2
KAGGLE_DATASET_DIR=/data/raw/garbage-classification-v2

# Opcional: use essas variáveis em vez de kaggle/kaggle.json
KAGGLE_USERNAME=
KAGGLE_KEY=

# Permite rodar uma amostra sintética se Kaggle não estiver configurado.
# Para obrigar uso da base real, altere para false.
ECOSORT_ALLOW_SAMPLE_DATA=true

# Limite por classe. 0 = usar tudo.
# Para teste rápido, use 30, 50 ou 100.
ECOSORT_MAX_IMAGES_PER_CLASS=0

# Se true, copia imagens originais para MinIO Bronze.
# Para primeira validação rápida, pode usar false.
ECOSORT_UPLOAD_IMAGES_TO_MINIO=true

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=ecosort
MINIO_SECRET_KEY=ecosort123
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=residuos-eventos
ECOSORT_STREAM_EVENTS_ON_PIPELINE=25
ECOSORT_STREAM_SECONDS=20

# Lakehouse local montado em volume
ECOSORT_DATA_DIR=/data
ECOSORT_LAKEHOUSE_DIR=/data/lakehouse
ECOSORT_DUCKDB_PATH=/data/duckdb/ecosort.duckdb

# Prefect
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_LOGGING_LEVEL=INFO

# Spark
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
